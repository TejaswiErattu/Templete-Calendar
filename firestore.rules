rules_version = '2';

// Firestore security rules — multi-user Study Planner
// Each signed-in user can read & write ONLY their own data tree.
service cloud.firestore {
  match /databases/{database}/documents {
    // Top-level user document and all subcollections
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
